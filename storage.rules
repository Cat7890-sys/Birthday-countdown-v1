rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'matimbangobeni78@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('.*@.*'))
      );
    }

    // Public read for all assets needed by the website
    // Only authorized admin users can upload, replace, delete, or modify admin-controlled media
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
