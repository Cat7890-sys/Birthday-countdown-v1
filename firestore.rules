rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'matimbangobeni78@gmail.com';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Birthday Content configuration & customization document
    // Public visitors can read the birthday content
    // Only authorized admin can modify website content; deletes are forbidden
    match /birthday_content/{contentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
