rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'matimbangobeni78@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('.*@.*'))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Birthday Content configuration & customization document
    // Public visitors can read the birthday content
    // Authenticated admin or visitor guestbook updates can write
    match /birthday_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
